<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="com.xgimi.misckey.permission.GTV_MIDDLEWARE_SERVICE" />

    <queries>
        <package android:name="com.xgimi.misckey" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="XGIMI Control Bridge"
        android:supportsRtl="true">

        <!-- Makes the vendor API visible to this app on XGIMI firmware. -->
        <uses-library
            android:name="com.xgimi.api"
            android:required="true" />

        <receiver
            android:name=".XgimiCommandReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="de.drapple.xgimi.SET_PICTURE_MODE" />
                <action android:name="de.drapple.xgimi.SET_MEMC" />
                <action android:name="de.drapple.xgimi.GET_STATUS" />
                <action android:name="de.drapple.xgimi.GET_PICTURE_JSON" />
                <action android:name="de.drapple.xgimi.GET_EXT_PQ_SETTINGS" />
                <action android:name="de.drapple.xgimi.MIDDLEWARE_EXEC_SYNC" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
